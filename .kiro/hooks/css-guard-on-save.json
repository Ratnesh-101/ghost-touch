{
  "version": "v1",
  "hooks": [
    {
      "name": "CSS guard on save",
      "trigger": "PostFileSave",
      "description": "Run CSS import ordering, token conformance, and alive animation property tests when styles change",
      "matcher": "frontend[\\\\/]src[\\\\/]styles[\\\\/].*\\.css$",
      "action": {
        "type": "command",
        "command": "npx vitest run tests/labTheme.prop.test.ts tests/css.imports.test.ts --reporter=dot"
      },
      "enabled": true
    }
  ]
}
