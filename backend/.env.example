# Ghost Touch — Backend Environment Configuration Example
# Copy this file to .env for local development:
#   cp .env.example .env
#
# On Render, secrets (sync: false) are entered in the Render dashboard.
# Never commit real API keys or .env files to version control.

# =============================================================================
# Vision & Language Model API Keys (Secrets)
# =============================================================================
# Primary provider: Google Gemini (Get key at https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# First fallback: OpenAI (Optional; get key at https://platform.openai.com/)
OPENAI_API_KEY=your_openai_api_key_here

# Last fallback: Nebius Token Factory (Optional; get key at https://tokenfactory.nebius.com/)
NEBIUS_API_KEY=your_nebius_api_key_here

# =============================================================================
# Vision Provider Chain & Models
# =============================================================================
# Order of fallback: gemini first, then openai, then nebius (last fallback).
# Providers without an API key configured are skipped automatically.
VISION_PROVIDERS=gemini,openai,nebius

# Model identifiers
GEMINI_MODEL=gemini-3.8-flash
OPENAI_MODEL=gpt-4.1-mini
NEBIUS_MODEL=openbmb/MiniCPM-V-4_5

# Gemini thinking level: off | minimal | low | medium | high | default
# "minimal" is recommended; avoids wasted calls while keeping latency low.
GEMINI_THINKING=minimal

# Custom API base URLs (optional; standard endpoints used if empty)
OPENAI_BASE_URL=https://api.openai.com/v1
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1

# =============================================================================
# Timeouts (Seconds)
# =============================================================================
# Per-call vision provider timeout (default: 8.0s)
PROVIDER_TIMEOUT_SECONDS=8.0

# Total end-to-end deadline for POST /api/v1/scene before Raw Mode fallback (default: 15.0s)
SCENE_TIMEOUT_SECONDS=15.0

# Total deadline for POST /api/v1/ask question answering (default: 10.0s)
ASK_TIMEOUT_SECONDS=10.0

# =============================================================================
# Scene Cache Settings
# =============================================================================
# Number of validated AI scenes to cache in memory (0 disables cache; default: 64)
SCENE_CACHE_SIZE=64

# Cache TTL in seconds (default: 21600 = 6 hours)
SCENE_CACHE_TTL_SECONDS=21600

# =============================================================================
# Rate Limiting & Concurrency Guards (Requests Per Minute & In-Flight per Client)
# =============================================================================
RATE_LIMIT_ASK_PER_MIN=40
RATE_LIMIT_SCENE_PER_MIN=20

# Per-client in-flight concurrency caps (prevents a single IP from holding all global slots)
ASK_CLIENT_MAX_CONCURRENCY=2
SCENE_CLIENT_MAX_CONCURRENCY=2

# Maximum retries per provider in extraction fallback chain (default: 1)
PROVIDER_RETRIES=1

# =============================================================================
# Paid API Budget (Lane h3 Cost Guard)
# =============================================================================
# Hard limit on total paid vision/language model calls per UTC day across all providers
# (default: 2000; 0 disables paid calls, falling back to deterministic/Raw Mode)
PAID_CALLS_PER_DAY=2000

# =============================================================================
# Server & CORS Configuration
# =============================================================================
# Comma-separated list of allowed frontend origins (no trailing slashes).
# In production, set to your Vercel URL (e.g. https://ghost-touch.vercel.app).
ALLOWED_ORIGINS=http://localhost:5173

# Port for local development (Render sets $PORT automatically in production)
PORT=8000
