# Ghost Touch backend environment.
# Copy to `.env` and fill in. Never commit the real .env.

# Vision provider: Google Gemini (primary)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_THINKING=minimal
# Deprecated alias:
# GEMINI_THINKING_BUDGET=0

# Vision provider: OpenAI (first fallback)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Vision provider: Nebius Token Factory (last fallback; also used for bulk test runs)
NEBIUS_API_KEY=
NEBIUS_MODEL=openbmb/MiniCPM-V-4_5
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1

# Provider chain configuration (comma-separated: gemini, openai, nebius)
VISION_PROVIDERS=gemini,openai,nebius
PROVIDER_TIMEOUT_SECONDS=8.0

# Scene extraction timeout before Raw Mode fallback (seconds).
SCENE_TIMEOUT_SECONDS=15.0

# Comma-separated CORS origins for the frontend (Vercel in prod).
ALLOWED_ORIGINS=http://localhost:5173
