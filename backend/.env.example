# Ghost Touch backend environment.
# Copy to `.env` and fill in. Never commit the real .env.

# Vision provider: Google Gemini (primary)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_THINKING=minimal
# Deprecated alias:
# GEMINI_THINKING_BUDGET=0

# Vision provider: NVIDIA hosted API (fallback)
NVIDIA_API_KEY=
NVIDIA_MODEL=meta/llama-3.2-11b-vision-instruct
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# Provider chain configuration (comma-separated: gemini, nvidia)
VISION_PROVIDERS=gemini,nvidia
PROVIDER_TIMEOUT_SECONDS=8.0

# Scene extraction timeout before Raw Mode fallback (seconds).
SCENE_TIMEOUT_SECONDS=15.0

# Comma-separated CORS origins for the frontend (Vercel in prod).
ALLOWED_ORIGINS=http://localhost:5173
