# Ghost Touch backend environment.
# Copy to `.env` and fill in. Never commit the real .env.

# Vision provider (Google Gemini via google-genai). Never hard-code the model.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Comma-separated CORS origins for the frontend (Vercel in prod).
ALLOWED_ORIGINS=http://localhost:5173

# Scene extraction timeout before Raw Mode fallback (seconds).
SCENE_TIMEOUT_SECONDS=15
GEMINI_THINKING_BUDGET=
NVIDIA_API_KEY=
NVIDIA_MODEL=
NVIDIA_BASE_URL=
VISION_PROVIDERS=
PROVIDER_TIMEOUT_SECONDS=
