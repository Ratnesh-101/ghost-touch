{
  "name": "ghost-touch-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Ghost Touch frontend — feel STEM diagrams by touch on Android.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:prop": "vitest run .prop.test",
    "gen:types": "json2ts -i ../backend/scene.schema.json -o src/types/scene.gen.ts --no-additionalProperties"
  },
  "dependencies": {
    "lz-string": "^1.5.0",
    "pdfjs-dist": "^6.4.299",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.5",
    "fast-check": "^4.10.2",
    "jsdom": "31.0.0",
    "json-schema-to-typescript": "^16.0.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.6",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "glob": "^14.0.3",
    "minimatch": "^11.0.5"
  }
}
