{
  "name": "ghost-touch-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Ghost Touch frontend — feel STEM diagrams by touch on Android.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:prop": "vitest run --dir tests -t prop",
    "gen:types": "json2ts -i ../backend/scene.schema.json -o src/types/scene.gen.ts --no-additionalProperties"
  },
  "dependencies": {
    "pdfjs-dist": "^6.4.299",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^2.1.9",
    "fast-check": "^4.10.2",
    "json-schema-to-typescript": "^16.0.0",
    "typescript": "~7.0.2",
    "vite": "^6.0.0",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^2.1.9"
  }
}
