# Ghost Touch — Frontend Environment Configuration Example
# Copy this file to .env.local for local development:
#   cp .env.example .env.local
#
# On Vercel, set VITE_API_URL in Project Settings -> Environment Variables.

# URL of the deployed Ghost Touch backend (no trailing slash).
# In production: https://ghost-touch-backend-xxxx.onrender.com
# In local dev:  http://localhost:8000
VITE_API_URL=http://localhost:8000
